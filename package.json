{
  "name": "keytester",
  "version": "1.0.0",
  "description": "LLM API Key Tester with chat UI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:zen": "cross-env USE_OPENCODE_PROXY=1 concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "start:zen": "cross-env USE_OPENCODE_PROXY=1 node dist/server/index.js",
    "test": "echo \"tests TBD\""
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "openai": "^4.70.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.10.0"
  }
}